    "valid": false,
    "code": "INVALID_STATES",
    "document": { "states": [] }
  },
  {
    "id": "duplicate-states",
    "schema": "lifecycle/lifecycle",
    "validate": "definitionEnvironmentLifecycle",
    "valid": false,
    "code": "INVALID_STATES",
    "document": { "states": ["active", "active"] }
  },
  {
    "id": "unknown-state",
    "schema": "lifecycle/lifecycle",
    "validate": "definitionEnvironmentLifecycle",
    "valid": false,
    "code": "SCHEMA_INVALID",
