      "state": "active"
    }
  },
  {
    "id": "observation-relative-instance",
    "schema": "lifecycle/observation",
    "validate": "validateObservation",
    "valid": false,
    "code": "SCHEMA_INVALID",
    "document": {
      "apiVersion": "lifecycle.distribution.dsh.dev/v1alpha1",
      "kind": "EnvironmentObservation",
      "instanceId": "instance-1",
      "revision": 3,
      "state": "active"
    }
  }
