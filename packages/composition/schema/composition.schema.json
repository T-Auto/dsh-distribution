{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/composition/composition/v1alpha1",
  "title": "composition/composition",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$(?![\\s\\S])"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "apiVersion": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*(?:(?:alpha|beta)[1-9][0-9]*)?$(?![\\s\\S])"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Z][A-Za-z0-9]*$(?![\\s\\S])"
                }
              },
              "required": [
                "apiVersion",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$(?![\\s\\S])"
            }
          }
        },
        "required": [
          "id",
          "ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "components"
  ],
  "additionalProperties": false
}
