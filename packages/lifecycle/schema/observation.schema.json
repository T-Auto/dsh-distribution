{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/lifecycle/observation/v1alpha1",
  "title": "lifecycle/observation",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "lifecycle.distribution.dsh.dev/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "EnvironmentObservation"
      ]
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "declared",
        "installed",
        "available",
        "active",
        "inactive",
        "broken",
        "migrating"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "instanceId",
    "revision",
    "state"
  ],
  "additionalProperties": false
}
