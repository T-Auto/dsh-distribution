{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/lodgement/entry/v1alpha1",
  "title": "lodgement/entry",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "discovery.distribution.dsh.dev/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "DiscoverableEntry"
      ]
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "distribution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "descriptorRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "contentDigest": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "removed"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "instanceId",
    "distribution",
    "descriptorRef",
    "revision",
    "contentDigest",
    "status"
  ],
  "additionalProperties": false
}
