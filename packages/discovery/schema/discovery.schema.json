{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/discovery/discovery/v1alpha1",
  "title": "discovery/discovery",
  "type": "object",
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
      }
    }
  },
  "required": [
    "references"
  ],
  "additionalProperties": false
}
