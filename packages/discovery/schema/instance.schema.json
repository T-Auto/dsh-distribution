{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/discovery/instance/v1alpha1",
  "title": "discovery/instance",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "distribution.dsh.dev/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "EnvironmentInstance"
      ]
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "distribution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "descriptorRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "instanceId",
    "distribution",
    "descriptorRef",
    "revision"
  ],
  "additionalProperties": false
}
