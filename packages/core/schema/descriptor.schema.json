{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/core/descriptor/v1alpha1",
  "title": "core/descriptor",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "distribution.dsh.dev/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "DistributionDescriptor"
      ]
    },
    "distribution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*(?:(?:alpha|beta)[1-9][0-9]*)?$(?![\\s\\S])"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$(?![\\s\\S])"
          },
          "required": {
            "type": "boolean"
          },
          "spec": {}
        },
        "required": [
          "apiVersion",
          "kind",
          "required",
          "spec"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "distribution",
    "protocols"
  ],
  "additionalProperties": false
}
