{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/portability/plan/v1alpha1",
  "title": "portability/plan",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "portability.distribution.dsh.dev/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "MigrationPlan"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "mode": {
          "type": "string",
          "enum": [
            "clone",
            "export",
            "migrate"
          ]
        },
        "sourceInstanceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "targetInstanceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approvedConditionalResources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$(?![\\s\\S])"
          }
        },
        "rollback": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "restore-checkpoint",
                "discard-new-target"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          "required": [
            "strategy",
            "reference"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "planId",
        "mode",
        "sourceInstanceId",
        "targetInstanceId",
        "sourceRevision",
        "approvedConditionalResources",
        "rollback"
      ],
      "additionalProperties": false
    },
    "ready": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$(?![\\s\\S])"
          },
          "action": {
            "type": "string",
            "enum": [
              "copy",
              "reference",
              "skip",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "PORTABLE",
              "CONDITION_APPROVED",
              "CONDITION_REQUIRED",
              "SECRET_EXCLUDED",
              "NONPORTABLE",
              "NOT_OWNED",
              "OVERLAPPING_LOCATION"
            ]
          }
        },
        "required": [
          "resourceId",
          "action",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "request",
    "ready",
    "entries"
  ],
  "additionalProperties": false
}
