{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Auto/dsh-distribution/schema/portability/journal/v1alpha1",
  "title": "portability/journal",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "portability.distribution.dsh.dev/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "MigrationJournal"
      ]
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "prepared",
        "copying",
        "verifying",
        "committed",
        "failed",
        "rolling-back",
        "rolled-back",
        "rollback-failed"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "planId",
    "revision",
    "state"
  ],
  "additionalProperties": false
}
